@@ -954,7 +954,6 @@ fn a_volume_description_has_only_the_help_keys() {
         "when a B read",
         "net web",
         "reach h tcp 22",
-        "window T",
         "names a b",
         "topic ed",
     ] {
@@ -968,6 +967,10 @@ fn a_volume_description_has_only_the_help_keys() {
     }
     // Not UTF-8: the parser says so; the key check has nothing to add.
     assert_eq!(volume_key_problem(b"\xff"), None);
+    // A window's title is taken (local overlay), and for_volume keeps it.
+    let w = "name ed\nsummary s\nusage ed\nwindow Ed\n";
+    assert_eq!(volume_key_problem(w.as_bytes()), None);
+    assert_eq!(for_volume(parse(w.as_bytes()).unwrap()).window.as_deref(), Some("Ed"));
 }
 
