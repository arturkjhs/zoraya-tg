 /// The keys a description read from the volume may have (ADR-0396 item 5):
 /// help, completion and usage, and no authority. Every other key (`names`,
-/// `cwd`, `program`, `reach`, `data`, `window`, `net`, `needs`, `setting`,
-/// `when`, `topic`) is refused at install.
-pub const VOLUME_KEYS: [&str; 7] = [
-    "name", "summary", "usage", "operand", "option", "exit", "question",
+/// `cwd`, `program`, `reach`, `data`, `net`, `needs`, `setting`, `when`,
+/// `topic`) is refused at install. `window TITLE` is taken for a native
+/// program (local overlay: a window for an installed native program, whose
+/// pills are the line's grants, ADR-0317's request): it asks for a window,
+/// which the panel draws with every grant the program holds.
+pub const VOLUME_KEYS: [&str; 8] = [
+    "name", "summary", "usage", "operand", "option", "exit", "question", "window",
 ];
 
 /// The first header line of `bytes` whose key is outside [`VOLUME_KEYS`]:
@@ -1582,7 +1585,8 @@ pub fn for_volume(mut d: Description) -> Description {
     d.net_web = false;
     d.reach = None;
     d.data = None;
-    d.window = None;
+    // Kept: the window's title (VOLUME_KEYS); the shell honours it for a native
+    // program only, through the panel, with the line's grants as its pills.
     d.settings.clear();
     d
 }
