+    // A window's title is taken (local overlay: the window of an installed native program).
+    good("name  ed\nsummary  s\nusage  ed\nwindow  Ed\n---\n").unwrap();
     // A body line that looks like a key is text.
     good("name  ed\nsummary  s\nusage  ed\n---\ndata  ed as ~/.x\nneeds  net-status\n").unwrap();
     // The messages say the key and the line.
@@ -531,8 +532,10 @@ fn a_description_that_names_authority_designates_nothing() {
             && !v.net_web
             && !v.needs_net_status
             && v.program.is_none()
-            && v.window.is_none()
     );
+    // The window's title stays (local overlay): the shell gives a window to a native
+    // installed program only, through the panel, with the line's grants as its pills.
+    assert_eq!(v.window.as_deref(), Some("ed"));
     assert_eq!(v.cwd, zoraya_describe::Cwd::Read);
 }
 
