+/// Applications a build adds to the dock after [`APPS`]: the names in
+/// `ZORAYA_EXTRA_APPS` when this crate is built, separated by spaces, each
+/// launched by its name (programs the build adds to the ramdisk).
+pub const EXTRA_APPS: &str = match option_env!("ZORAYA_EXTRA_APPS") {
+    Some(names) => names,
+    None => "",
+};
+
+/// The dock's applications in order: [`APPS`], then [`EXTRA_APPS`].
+pub fn apps() -> Vec<(&'static str, &'static str)> {
+    let mut all = APPS.to_vec();
+    all.extend(EXTRA_APPS.split_whitespace().map(|n| (n, n)));
+    all
+}
