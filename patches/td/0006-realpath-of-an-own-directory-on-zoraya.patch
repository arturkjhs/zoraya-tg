--- a/tdutils/td/utils/port/path.cpp
+++ b/tdutils/td/utils/port/path.cpp
@@ -138,6 +138,14 @@
   if (err != full_path) {
     if (ignore_access_denied && (errno == EACCES || errno == EPERM)) {
       res = slice.str();
+#if defined(__zoraya__)
+      // zoraya-tg: a program's own directory is an entry of its own table at its view path
+      // (~/.config/NAME); its parents need not exist through the other entries, so walking
+      // the path from / fails with ENOENT. The directory itself is there (the caller made
+      // it): it is taken as given, as when access is denied.
+    } else if (ignore_access_denied && (errno == ENOENT || errno == ENOTDIR) && slice[0] == '/') {
+      res = slice.str();
+#endif
     } else {
       return OS_ERROR(PSLICE() << "Realpath failed for \"" << slice << '"');
     }
